# Runtime
HOST=127.0.0.1
PORT=3737
CACP_DB=cacp.db

# local | cloud
CACP_DEPLOYMENT_MODE=local
CACP_ENABLE_LOCAL_LAUNCH=true

# Required in cloud mode. Use a random value of at least 32 characters.
CACP_PUBLIC_ORIGIN=https://cacp.example.com
CACP_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters

# Request and room limits
CACP_BODY_LIMIT_BYTES=1048576
CACP_MAX_MESSAGE_LENGTH=4000
CACP_MAX_ATTACHMENT_BYTES=10485760
CACP_MAX_ATTACHMENTS_PER_MESSAGE=5
CACP_MAX_ROOM_ATTACHMENT_BYTES=52428800
CACP_ATTACHMENT_ABANDON_MS=900000
CACP_MAX_PARTICIPANTS_PER_ROOM=20
CACP_MAX_AGENTS_PER_ROOM=3
CACP_MAX_SOCKETS_PER_ROOM=50
CACP_RATE_LIMIT_WINDOW_MS=60000
CACP_ROOM_CREATE_LIMIT=20
CACP_INVITE_CREATE_LIMIT=60
CACP_JOIN_ATTEMPT_LIMIT=60
CACP_PAIRING_CREATE_LIMIT=30
CACP_MESSAGE_CREATE_LIMIT=120
CACP_PRESENCE_CHANGE_LIMIT=30
CACP_TYPING_EVENT_LIMIT=60
CACP_ORBIT_EVENT_LIMIT=120

# Optional local Agent CLI overrides
# CACP_CLAUDE_PATH=C:\path\to\claude.exe
# CACP_CODEX_PATH=C:\path\to\codex.exe
# CACP_COPILOT_PATH=C:\path\to\copilot.exe
# CACP_KIMI_PATH=C:\path\to\kimi.exe

# Web build
VITE_CACP_DEPLOYMENT_MODE=local
